meta {
  name: Refresh Token
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/token/refresh/
  body: json
  auth: none
}

body:json {
  {
    "refresh": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.status === 200) {
    if (res.body.access) {
      bru.setEnvVar("accessToken", res.body.access);
    }
  }
}
