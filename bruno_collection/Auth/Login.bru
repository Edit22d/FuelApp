meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login/
  body: json
  auth: none
}

body:json {
  {
    "phone_number": "0700000000",
    "password": "admin123"
  }
}

script:post-response {
  if (res.status === 200) {
    if (res.body.tokens) {
      bru.setEnvVar("accessToken", res.body.tokens.access);
      bru.setEnvVar("refreshToken", res.body.tokens.refresh);
    }
  }
}
